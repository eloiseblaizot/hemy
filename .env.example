# Copier vers .env
#
# DATABASE_URL : connexion utilisée par le site (poolée en production).
# DIRECT_URL   : connexion directe, utilisée par les migrations et l'ingestion.
#
# --- Développement local (npm run db:dev) ---
DATABASE_URL="postgresql://hemy:hemy@127.0.0.1:55432/hemy"
DIRECT_URL="postgresql://hemy:hemy@127.0.0.1:55432/hemy"

# --- Production (Neon / Vercel Postgres) ---
# DATABASE_URL="postgresql://user:pwd@ep-xxx-pooler.eu-central-1.aws.neon.tech/hemy?sslmode=require"
# DIRECT_URL="postgresql://user:pwd@ep-xxx.eu-central-1.aws.neon.tech/hemy?sslmode=require"

# Secret protégeant /api/cron/sync (Vercel l'envoie en `Authorization: Bearer …`).
# Générer avec : openssl rand -hex 32
CRON_SECRET=""

# Optionnel : URL publique du site, pour robots.txt et sitemap.xml
# NUXT_PUBLIC_SITE_URL="https://hemy.example.fr"

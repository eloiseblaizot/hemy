{
  "version": 3,
  "overrides": {},
  "routes": [
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/builds/meta/(.*)"
    },
    {
      "headers": {
        "cache-control": "no-store"
      },
      "src": "/api/cron/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=1, immutable"
      },
      "src": "/_nuxt/builds/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/(.*)"
    },
    {
      "src": "/_nuxt/builds/meta(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt/builds(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "(?<__isr_route>/)",
      "dest": "/index-isr?__isr_route=$__isr_route"
    },
    {
      "src": "(?<__isr_route>/api/cron/(?:.*))",
      "dest": "/__fallback"
    },
    {
      "src": "(?<__isr_route>/mes-elus/_payload.json)",
      "dest": "/mes-elus/_payload.json-isr?__isr_route=$__isr_route"
    },
    {
      "src": "(?<__isr_route>/__nuxt_error)",
      "dest": "/__fallback"
    },
    {
      "src": "(?<__isr_route>/scrutins/(?:.*))",
      "dest": "/scrutins/[...]-isr?__isr_route=$__isr_route"
    },
    {
      "src": "(?<__isr_route>/deputes/(?:.*))",
      "dest": "/deputes/[...]-isr?__isr_route=$__isr_route"
    },
    {
      "src": "(?<__isr_route>/senateurs/(?:.*))",
      "dest": "/senateurs/[...]-isr?__isr_route=$__isr_route"
    },
    {
      "src": "(?<__isr_route>/groupes/(?:.*))",
      "dest": "/groupes/[...]-isr?__isr_route=$__isr_route"
    },
    {
      "src": "(?<__isr_route>/chambre/(?:.*))",
      "dest": "/chambre/[...]-isr?__isr_route=$__isr_route"
    },
    {
      "src": "(?<__isr_route>/mes-elus)",
      "dest": "/mes-elus-isr?__isr_route=$__isr_route"
    },
    {
      "src": "(?<__isr_route>/api/(?:.*))",
      "dest": "/__fallback"
    },
    {
      "src": "(?<__isr_route>/_payload.json)",
      "dest": "/_payload.json-isr?__isr_route=$__isr_route"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/mes-elus",
      "dest": "/mes-elus"
    },
    {
      "src": "/api/search",
      "dest": "/api/search"
    },
    {
      "src": "/api/scrutins",
      "dest": "/api/scrutins"
    },
    {
      "src": "/api/fraicheur",
      "dest": "/api/fraicheur"
    },
    {
      "src": "/api/elus",
      "dest": "/api/elus"
    },
    {
      "src": "/api/departements",
      "dest": "/api/departements"
    },
    {
      "src": "/api/cron/sync",
      "dest": "/api/cron/sync"
    },
    {
      "src": "/__nuxt_error",
      "dest": "/__nuxt_error"
    },
    {
      "src": "/",
      "dest": "/index"
    },
    {
      "src": "/senateurs/(?<slug>[^/]+)",
      "dest": "/senateurs/[slug]"
    },
    {
      "src": "/scrutins/(?<id>[^/]+)",
      "dest": "/scrutins/[id]"
    },
    {
      "src": "/groupes/(?<id>[^/]+)",
      "dest": "/groupes/[id]"
    },
    {
      "src": "/deputes/(?<slug>[^/]+)",
      "dest": "/deputes/[slug]"
    },
    {
      "src": "/chambre/(?<chambre>[^/]+)",
      "dest": "/chambre/[chambre]"
    },
    {
      "src": "/api/scrutins/(?<id>[^/]+)",
      "dest": "/api/scrutins/[id]"
    },
    {
      "src": "/api/groupes/(?<id>[^/]+)",
      "dest": "/api/groupes/[id]"
    },
    {
      "src": "/api/elus/(?<slug>[^/]+)/votes",
      "dest": "/api/elus/[slug]/votes"
    },
    {
      "src": "/api/elus/(?<slug>[^/]+)",
      "dest": "/api/elus/[slug]"
    },
    {
      "src": "/api/departements/(?<code>[^/]+)",
      "dest": "/api/departements/[code]"
    },
    {
      "src": "/api/chambre/(?<chambre>[^/]+)",
      "dest": "/api/chambre/[chambre]"
    },
    {
      "src": "/__nuxt_island/(?:.*)",
      "dest": "/__nuxt_island/[...]"
    },
    {
      "src": "/(.*)",
      "dest": "/__fallback"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "20 5 * * *"
    }
  ]
}
    "@vercel/functions": "^3.7.6",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "iconv-lite": "^0.7.3",
    "nuxt": "^4.4.8",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",

{
  "name": "hemy",
  "private": true,
  "type": "module",
  "description": "Hemy — visualisation des scrutins de l'Assemblée nationale et du Sénat",
  "scripts": {
    "dev": "nuxt dev",
    "build": "node scripts/vercel-build.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "prisma generate && nuxt prepare",
    "db:dev": "tsx scripts/dev-db.ts",

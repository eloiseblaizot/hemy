    "db:studio": "prisma studio",
    "sync": "tsx scripts/cli/sync.ts",
    "sync:full": "SYNC_FULL=1 tsx scripts/cli/sync.ts",
    "presence": "tsx scripts/cli/presence.ts",
    "search:reindex": "tsx scripts/cli/reindex.ts",
    "stats": "tsx scripts/db-stats.ts"
